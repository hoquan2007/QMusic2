# QMusic Environment Variables

# Audius Application Identifier
NEXT_PUBLIC_AUDIUS_APP_NAME=QMusic

# Optional: Custom Audius Discovery Node (defaults to official load balancer https://api.audius.co)
# NEXT_PUBLIC_AUDIUS_HOST=https://api.audius.co

# Optional: Jamendo API Client ID (Required only if Jamendo provider is enabled)
# Get a free client ID at https://developer.jamendo.com/
JAMENDO_CLIENT_ID=

# Optional: Supabase configuration (for multi-device sync if configured)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

